<UserControl
    x:Class="v2rayN.Views.SettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:loc="clr-namespace:v2rayN.Common"
    xmlns:conv="clr-namespace:v2rayN.Converters">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <!-- Card: rounded, themed background, acts as the "little window" -->
    <Border
        CornerRadius="12"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        BorderBrush="{DynamicResource ControlElevationBorderBrush}"
        BorderThickness="1"
        Padding="24,16,24,20">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header: title on left, close (×) on right -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="18"
                    FontWeight="SemiBold"
                    Text="{Binding Source={x:Static loc:LocalizedStrings.Instance}, Path=Settings}" />
                <ui:Button
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Width="32"
                    Height="32"
                    Padding="0"
                    Appearance="Transparent"
                    Click="OnCloseClick"
                    ToolTip="Close">
                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="14" />
                </ui:Button>
            </Grid>

            <!-- Settings content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- Auto-start -->
                    <Grid Margin="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Text="{Binding Source={x:Static loc:LocalizedStrings.Instance}, Path=SettingsAutoStart}" />
                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoStart}" />
                    </Grid>

                    <!-- Auto-connect -->
                    <Grid Margin="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Text="{Binding Source={x:Static loc:LocalizedStrings.Instance}, Path=SettingsAutoConnect}" />
                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoConnect}" />
                    </Grid>

                    <Separator Margin="0,10" Opacity="0.2" />

                    <!-- Geo lists section -->
                    <TextBlock
                        Margin="0,0,0,6"
                        FontWeight="SemiBold"
                        Text="{Binding Source={x:Static loc:LocalizedStrings.Instance}, Path=SettingsGeoSection}" />
                    <Grid Margin="0,2,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            Opacity="0.6"
                            Text="{Binding GeoUpdatedText}" />
                        <ui:Button
                            Grid.Column="1"
                            Padding="12,6"
                            Appearance="Secondary"
                            Command="{Binding UpdateGeoNowCommand}"
                            IsEnabled="{Binding IsUpdatingGeo, Converter={StaticResource BoolToVis}, ConverterParameter=Inv}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Margin="0,0,6,0" Symbol="ArrowSync24" />
                                <TextBlock Text="{Binding Source={x:Static loc:LocalizedStrings.Instance}, Path=SettingsGeoUpdateNow}" />
                            </StackPanel>
                        </ui:Button>
                    </Grid>

                    <Separator Margin="0,10" Opacity="0.2" />

                    <!-- Logs -->
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:Button
                            Grid.Column="0"
                            Margin="0,0,4,0"
                            Padding="0,8"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Appearance="Secondary"
                            Command="{Binding ExportLogsCommand}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Margin="0,0,6,0" Symbol="ArrowDownload24" />
                                <TextBlock Text="{Binding Source={x:Static loc:LocalizedStrings.Instance}, Path=SettingsExportLogs}" />
                            </StackPanel>
                        </ui:Button>
                        <ui:Button
                            Grid.Column="1"
                            Margin="4,0,0,0"
                            Padding="0,8"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Appearance="Secondary"
                            Command="{Binding OpenLogFolderCommand}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Margin="0,0,6,0" Symbol="FolderOpen24" />
                                <TextBlock Text="{Binding Source={x:Static loc:LocalizedStrings.Instance}, Path=SettingsOpenLogFolder}" />
                            </StackPanel>
                        </ui:Button>
                    </Grid>

                    <Separator Margin="0,10" Opacity="0.2" />

                    <!-- Hidden BT toggle (revealed via 7 taps on version) -->
                    <StackPanel Visibility="{Binding IsSecretRevealed, Converter={StaticResource BoolToVis}}">
                        <Grid Margin="0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Text="{Binding Source={x:Static loc:LocalizedStrings.Instance}, Path=SecretToggle}" />
                            <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding RouteBittorrentViaProxy}" />
                        </Grid>
                        <Separator Margin="0,10" Opacity="0.2" />
                    </StackPanel>

                    <!-- InfoBar for feedback -->
                    <ui:InfoBar
                        Margin="0,0,0,6"
                        IsClosable="True"
                        IsOpen="{Binding SecretInfoMessage, Converter={StaticResource BoolToVis}}"
                        Message="{Binding SecretInfoMessage}"
                        Severity="Success" />

                    <!-- Version (clickable for easter egg) -->
                    <Border
                        Margin="0,4,0,0"
                        Padding="4"
                        Background="Transparent"
                        Cursor="Hand">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding VersionTappedCommand}" />
                        </Border.InputBindings>
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="11"
                            Opacity="0.45"
                            Text="{Binding Version}" />
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
