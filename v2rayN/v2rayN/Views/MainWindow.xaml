<ui:FluentWindow
    x:Class="v2rayN.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:tray="clr-namespace:Wpf.Ui.Tray.Controls;assembly=Wpf.Ui.Tray"
    xmlns:loc="clr-namespace:v2rayN.Common"
    xmlns:conv="clr-namespace:v2rayN.Converters"
    xmlns:view="clr-namespace:v2rayN.Views"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    Title="VytswellRay"
    Width="520"
    Height="600"
    MinWidth="460"
    MinHeight="520"
    Background="Transparent"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <conv:StateToColorConverter x:Key="StateToColor" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <!--
        Outer single-cell Grid: all layers stack here.
        Background="Transparent" on FluentWindow lets DWM Mica show through
        wherever WPF elements have no opaque fill.
    -->
    <Grid>

        <!-- ═══ Layer 0 (bottom): all visible content — blurred when a dialog is open ═══ -->
        <Grid x:Name="MainContent">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--
                Row 0 — title bar.
                The globe button is overlaid directly here (Panel.ZIndex + IsHitTestVisibleInChrome)
                instead of TitleBar.Header, which in WPF-UI renders as a sub-row *below*
                the title chrome and therefore looks unanchored.
            -->
            <Grid Grid.Row="0">
                <ui:TitleBar
                    Title="VytswellRay"
                    ShowMaximize="False" />

                <!--
                    Globe / language toggle: right side of title bar, before system buttons.
                    Minimize + Close each ≈ 46 px → 100 px right margin clears them safely.
                    WindowChrome.IsHitTestVisibleInChrome prevents the HTCAPTION drag area
                    from swallowing the click.
                -->
                <ui:Button
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Width="64"
                    Height="30"
                    Margin="0,0,100,0"
                    Padding="6,0"
                    Appearance="Transparent"
                    Panel.ZIndex="100"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"
                    Command="{Binding ToggleLanguageCommand}"
                    ToolTip="RU / EN">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon FontSize="13" Symbol="Globe24" />
                        <TextBlock
                            Margin="4,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Text="{Binding Source={x:Static loc:LocalizedStrings.Instance}, Path=LanguageCode}" />
                    </StackPanel>
                </ui:Button>
            </Grid>

            <!-- Row 1 — centered Connect button + status -->
            <Grid Grid.Row="1">
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                    <ui:Button
                        Width="240"
                        Height="72"
                        Margin="0,0,0,32"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Appearance="Primary"
                        Command="{Binding ToggleConnectCommand}"
                        CornerRadius="36"
                        FontSize="19"
                        FontWeight="SemiBold">
                        <TextBlock Text="{Binding ConnectButtonText}" />
                    </ui:Button>

                    <!-- Status line: colored dot + text -->
                    <StackPanel
                        Margin="0,0,0,6"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal">
                        <Ellipse
                            Width="10"
                            Height="10"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Fill="{Binding State, Converter={StaticResource StateToColor}}" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="13"
                            Text="{Binding StatusText}" />
                    </StackPanel>

                    <!-- Active profile sub-label -->
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="12"
                        Opacity="0.6"
                        Text="{Binding ActiveText}" />
                </StackPanel>
            </Grid>

            <!-- Row 2 — bottom bar: two equal secondary buttons -->
            <Grid Grid.Row="2" Margin="24,0,24,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ui:Button
                    Grid.Column="0"
                    Margin="0,0,6,0"
                    Padding="0,14"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Appearance="Secondary"
                    Command="{Binding ShowConnectionsCommand}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Margin="0,0,8,0" Symbol="List24" />
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizedStrings.Instance}, Path=Connections}" />
                    </StackPanel>
                </ui:Button>

                <ui:Button
                    Grid.Column="1"
                    Margin="6,0,0,0"
                    Padding="0,14"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Appearance="Secondary"
                    Command="{Binding ShowSettingsCommand}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Margin="0,0,8,0" Symbol="Settings24" />
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizedStrings.Instance}, Path=Settings}" />
                    </StackPanel>
                </ui:Button>
            </Grid>
        </Grid>

        <!-- ═══ Layer 1: Settings overlay (dim backdrop + card) ═══ -->
        <!--
            Full-window hit-testable backdrop blocks all input to MainContent.
            ZIndex 50 = above blurred MainContent, below ContentDialogHost (100).
        -->
        <Grid
            x:Name="SettingsOverlay"
            Panel.ZIndex="50"
            Visibility="Collapsed">

            <Border Background="#A0000000" />

            <Border
                MaxWidth="460"
                MaxHeight="520"
                Margin="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <view:SettingsDialog x:Name="SettingsPanel" />
            </Border>
        </Grid>

        <!-- ═══ Layer 2 (top): ContentDialogHost for ConnectionsDialog ═══ -->
        <ui:ContentDialogHost
            x:Name="DialogHost"
            Panel.ZIndex="100" />

        <!-- System tray icon (not a WPF visual element) -->
        <tray:NotifyIcon
            x:Name="TrayIcon"
            FocusOnLeftClick="False"
            Icon="pack://application:,,,/Resources/v2rayN.ico"
            MenuOnRightClick="True"
            TooltipText="VytswellRay"
            LeftClick="OnTrayLeftClick">
            <tray:NotifyIcon.Menu>
                <ContextMenu>
                    <MenuItem Header="{Binding ConnectButtonText}" Command="{Binding ToggleConnectCommand}" />
                    <MenuItem Header="{Binding Source={x:Static loc:LocalizedStrings.Instance}, Path=TrayExit}" Command="{Binding QuitCommand}" />
                </ContextMenu>
            </tray:NotifyIcon.Menu>
        </tray:NotifyIcon>

    </Grid>
</ui:FluentWindow>
